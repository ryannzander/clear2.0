# Copy to .env (gitignored). Never put real secrets in this file.
# Paths are this machine's; scripts/storage.py reads them. Check: uv run python scripts/storage.py

# Raw data working copy (internal NVMe). data/raw is a junction to it.
CLEAR_RAW_DIR=E:\CLEAR 2.0\RAW Data
# Prior pipeline outputs, read-only reference (Seagate). data/prior is a junction to it.
CLEAR_PRIOR_DIR=D:\CLEAR 2.0\Cleaned Data

# Backups on the Seagate, used by /backup-check. Same layout as the folder they back up.
CLEAR_BACKUP_RAW_DIR=D:\CLEAR 2.0\RAW Data
CLEAR_BACKUP_ARCHIVE_DIR=D:\CLEAR 2.0\archive

# PurpleAir API key, set when /ingest first needs it:
# PURPLEAIR_API_KEY=

# CDS config lives in ~/.cdsapirc, never here
